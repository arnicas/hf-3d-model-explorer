dist/
dist-ssr/
*.local
*.tsbuildinfo
tsconfig.tsbuildinfo
.vite/
node_modules/.vite/
vite.config.ts.timestamp-*

# ── Bundler / tool caches ─────────────────────────────────
.bun/
bun.lockb
.cache/
.parcel-cache/
.eslintcache
.stylelintcache

# ── Test / coverage ───────────────────────────────────────
coverage/
.nyc_output/
playwright-report/
test-results/

# ── Logs ──────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
bun-debug.log*
pnpm-debug.log*

# ── OS / editor cruft ─────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# ── Local scratch ─────────────────────────────────────────
tmp/
temp/
scratch/
*.bak

# ── Deliberately NOT ignored ──────────────────────────────
# public/manifest-3d.json and public/manifest-art.json are committed on purpose.
# Regenerating them hits the Hugging Face API and takes a long time / is
# rate-limited, so they ship as static assets with the app.
# Keep bun.lock committed too (dependency lockfile).

# Personal deploy script (server details)
deploy.sh
